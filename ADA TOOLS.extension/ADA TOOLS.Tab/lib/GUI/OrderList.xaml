<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Order List"
    Height="550" Width="440"
    MinWidth="440"
    MinHeight="550" MaxHeight="550"
    WindowStartupLocation="CenterScreen"
    HorizontalAlignment="Center"
    ShowInTaskbar="True"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="#1E1E1E">

    <!--MAIN-->
    <Grid Background="#1E1E1E">

        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>

        <!--HEADER START-->
        <Grid   MouseDown="header_drag"
                Background="{StaticResource header_background}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>

            <!--LOGO-->
            <DockPanel  Grid.Column="0"
                        Grid.ColumnSpan="2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left">

                <Image x:Name="logo_icon" Width="18" Height="18" Margin="6,0,4,0" Stretch="Uniform"/>

                <TextBlock>
                    <Hyperlink
                        RequestNavigate="Hyperlink_RequestNavigate"
                        NavigateUri="https://www.linkedin.com/company/80151029"
                        FontSize="12px"
                        FontWeight="Heavy"
                        Foreground="{StaticResource text_white}">
                        ADA-Tools
                    </Hyperlink>
                </TextBlock>
            </DockPanel>

            <!--__TITLE__-->
            <TextBlock x:Name="main_title"
                Text="__title__"
                Grid.Column="1"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Foreground="{StaticResource text_white}"
                />

            <!--CLOSE-->
            <Button
                Content="Close"
                Grid.Column="2"
                Width="60" Height="20"
                FontSize="10"
                Click="button_close"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                    />
        </Grid>
        <!--HEADER END-->

        <!--LIST START-->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Top"
                    Margin="10,8,10,5">

            <Label x:Name="text_label"  Content="Set the order:"
                   Foreground="{StaticResource text_magenta}"/>

            <Separator Background="{StaticResource border_magenta}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="text_top" Text="TOP"
                               Foreground="{StaticResource text_gray}"
                               FontSize="10" Margin="4,4,0,2"/>

                    <ListBox x:Name="main_ListBox"
                             Height="330"
                             Background="{StaticResource header_background}"
                             Foreground="{StaticResource text_white}"
                             SelectionMode="Single"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             BorderBrush="{StaticResource border_magenta}">

                        <ListBox.Resources>
                            <Style TargetType="ListBox">
                                <Style.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="10"/>
                                    </Style>
                                </Style.Resources>
                            </Style>
                        </ListBox.Resources>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Margin="4,2,4,2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="text_bottom" Text="BOTTOM"
                               Foreground="{StaticResource text_gray}"
                               FontSize="10" Margin="4,2,0,0"/>
                </StackPanel>

                <!--MOVE BUTTONS-->
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">
                    <Button Content="To Top"    Click="button_to_top"    Height="24" Margin="0,4"/>
                    <Button Content="Up"        Click="button_up"        Height="24" Margin="0,4"/>
                    <Button Content="Down"      Click="button_down"      Height="24" Margin="0,4"/>
                    <Button Content="To Bottom" Click="button_to_bottom" Height="24" Margin="0,4"/>
                </StackPanel>
            </Grid>

            <!--MAIN BUTTON-->
            <Button x:Name="button_main"
                    Content="OK"
                    Click="button_ok"
                    Height="30"
                    Width="210"
                    Margin="5,12,5,5"
                    />

        </StackPanel>
        <!--LIST END-->

        <!--FOOTER START-->
        <Grid Grid.Row="2" Background="{StaticResource header_background}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!--IMAGE-->
            <TextBlock>
                <Hyperlink  NavigateUri="https://www.learnrevitapi.com" RequestNavigate="Hyperlink_RequestNavigate">
                               <Image  Height="20"   Margin="1"  HorizontalAlignment="Left"   VerticalAlignment="Top"
                                   Source="https://www.learnrevitapi.com/static/img_new/logo/logo_learnrevitapi.png" />
                </Hyperlink>
            </TextBlock>

            <!--VERSION-->
            <TextBlock x:Name="footer_version"
              Text="Version: 1.0"
              Grid.Column="1"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Foreground="{StaticResource text_gray}"
    />

            <!--Ko-Fi-->
            <TextBlock  Grid.Column="2"
              VerticalAlignment="Center"
              HorizontalAlignment="Right"
              Margin="0,0,10,0">
              <Hyperlink
                  RequestNavigate="Hyperlink_RequestNavigate"
                  NavigateUri="https://www.ko-fi.com/ErikFrits"
                  FontWeight="Medium"
                  Foreground="{StaticResource button_bg_hover}">
                  Support ADA-Tools
              </Hyperlink>
            </TextBlock>
        </Grid>
        <!--FOOTER END-->
    </Grid>
</Window>
