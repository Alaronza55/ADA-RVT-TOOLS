<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Select"
    Height="260" Width="320"
    MinWidth="320"
    MinHeight="260"
    WindowStartupLocation="CenterScreen"
    HorizontalAlignment="Center"
    ShowInTaskbar="True"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="#1E1E1E">

    <!--MAIN-->
    <Grid Background="#1E1E1E">

        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <!--HEADER START-->
        <Grid   MouseDown="header_drag"
                Background="{StaticResource header_background}"
                Grid.ColumnSpan="2">
            <!--HEADER GRID-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>

            <!--LOGO-->
            <DockPanel  Grid.Column="0"
                        Grid.ColumnSpan="2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left">

                <Image x:Name="logo_icon" Width="18" Height="18" Margin="6,0,4,0" Stretch="Uniform"/>

                <TextBlock>
                    <Hyperlink
                        RequestNavigate="Hyperlink_RequestNavigate"
                        NavigateUri="https://www.linkedin.com/company/80151029"
                        FontSize="12px"
                        FontWeight="Heavy"
                        Foreground="{StaticResource text_white}">
                        ADA-Tools
                    </Hyperlink>
                </TextBlock>
            </DockPanel>

            <!--__TITLE__-->
            <TextBlock x:Name="main_title"
                Text="__title__"
                Grid.Column="1"
                TextAlignment="Center"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Foreground="{StaticResource text_white}"
                />

            <!--CLOSE-->
            <Button
                Content="Close"
                Grid.Column="2"
                Width="60" Height="20"
                FontSize="10"
                Click="button_close"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                    />
        </Grid>
        <!--HEADER END-->

        <!--BODY START-->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    Margin="15,10,15,10">

            <Separator Background="{StaticResource border_magenta}" Margin="0,0,0,10"/>

            <Label x:Name="text_label" Content="Choose an option:"
                   Foreground="{StaticResource text_magenta}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,5"/>

            <!--OPTION BUTTONS - up to 4, unused ones collapsed in code-behind-->
            <Button x:Name="btn_option_0" Content="Option 1" Click="button_option_click" Height="34" Margin="5"/>
            <Button x:Name="btn_option_1" Content="Option 2" Click="button_option_click" Height="34" Margin="5"/>
            <Button x:Name="btn_option_2" Content="Option 3" Click="button_option_click" Height="34" Margin="5"/>
            <Button x:Name="btn_option_3" Content="Option 4" Click="button_option_click" Height="34" Margin="5"/>
        </StackPanel>
        <!--BODY END-->

        <!--FOOTER START-->
        <Grid Grid.Row="2" Background="{StaticResource header_background}">
            <!--FOOTER GRID-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!--VERSION-->
            <TextBlock x:Name="footer_version"
              Text="Version: 1.0"
              Grid.Column="0"
              VerticalAlignment="Center"
              HorizontalAlignment="Left"
              Margin="10,0,0,0"
              Foreground="{StaticResource text_gray}"
    />

            <!--Ko-Fi-->
            <TextBlock  Grid.Column="1"
              VerticalAlignment="Center"
              HorizontalAlignment="Right"
              Margin="0,0,10,0">
              <Hyperlink
                  RequestNavigate="Hyperlink_RequestNavigate"
                  NavigateUri="https://www.ko-fi.com/ErikFrits"
                  FontWeight="Medium"
                  Foreground="{StaticResource button_bg_hover}">
                  Support ADA-Tools
              </Hyperlink>
            </TextBlock>
        </Grid>
        <!--FOOTER END-->
    </Grid>
</Window>
